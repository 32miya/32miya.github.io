rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 起動回数・コメント数（誰でも読める／1回につき+1だけ書ける）
    match /stats/{gameId} {
      allow read: if true;
      allow create: if gameId.size() <= 80
        && request.resource.data.keys().hasOnly(['plays', 'comments'])
        && request.resource.data.get('plays', 0) in [0, 1]
        && request.resource.data.get('comments', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['plays', 'comments'])
        && request.resource.data.get('plays', 0) - resource.data.get('plays', 0) in [0, 1]
        && request.resource.data.get('comments', 0) - resource.data.get('comments', 0) in [0, 1];
      allow delete: if false;
    }

    // コメント（誰でも読める・投稿できる／書き換え・削除は不可＝管理画面からのみ）
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['game', 'name', 'text', 'createdAt'])
        && request.resource.data.game is string && request.resource.data.game.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
